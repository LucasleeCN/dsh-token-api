  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasleeCN/dsh-token-api.git"
  },
  "bugs": {
    "url": "https://github.com/LucasleeCN/dsh-token-api/issues"
  },
  "homepage": "https://github.com/LucasleeCN/dsh-token-api#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
